# ============================================================
# Distill-Everything 配置文件
# 复制此文件为 .env 并填写实际值
# ============================================================

# ---- B站Cookie配置 ----
# 方式一（推荐）: 运行 python main.py login 扫码登录，自动获取并缓存凭据
# 方式二（手动）: 从浏览器 F12 → Application → Cookies 获取，填入下方
# 留空则自动使用扫码登录
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
BILIBILI_BUVID3=

# ---- UP主配置 ----
# UP主的UID（在UP主主页URL中可以找到）
UP_UID=12345678

# ---- LLM 提供商选择 ----
# 可选值: claude / openai / qwen / deepseek / ollama（本地免费）
LLM_PROVIDER=claude

# ---- Claude API 配置 ----
# 从 https://console.anthropic.com/ 获取
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- OpenAI API 配置 ----
# 从 https://platform.openai.com/ 获取
OPENAI_API_KEY=your_openai_api_key_here
# API Base URL（支持兼容接口，如自部署或第三方代理）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ---- 通义千问 Qwen 配置（阿里云 DashScope）----
# 从 https://dashscope.console.aliyun.com/ 获取 API Key
QWEN_API_KEY=your_dashscope_api_key_here
# DashScope OpenAI 兼容接口地址（一般无需修改）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选模型: qwen3-235b-a22b / qwen3-30b-a3b / qwen-turbo-latest 等
QWEN_MODEL=qwen3-235b-a22b

# ---- DeepSeek 配置 ----
# 从 https://platform.deepseek.com/ 获取 API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DeepSeek API 地址（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选模型: deepseek-reasoner (R1) / deepseek-chat (V3) 等
DEEPSEEK_MODEL=deepseek-reasoner

# ---- Ollama 本地模型配置（免费，需先安装 Ollama）----
# 安装: https://ollama.com → ollama pull qwen2.5:7b
# 推荐模型: qwen2.5:7b（中文强）/ qwen2.5:3b（显存少）/ llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# ---- FunASR 配置 ----
# ASR模型名称（默认 paraformer-zh）
FUNASR_MODEL=paraformer-zh
# VAD模型（语音活动检测）
FUNASR_VAD_MODEL=fsmn-vad
# 标点恢复模型
FUNASR_PUNC_MODEL=ct-punc

# ---- 目录配置 ----
DATA_DIR=./data
OUTPUT_DIR=./output

# ===== 飞书开放平台（妙记下载，Stage 1）=====
# 自建应用 App ID / Secret（开放平台后台获取；需开通 minutes:minutes.media:export 权限）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ---- 跨平台蒸馏默认值 ----
# 抖音登录使用持久化 Chromium profile；不要提交或共享该目录
DOUYIN_PROFILE_DIR=./data/browser/douyin
DOUYIN_LOGIN_TIMEOUT=180
DISTILL_DOWNLOAD_WORKERS=3
DISTILL_ASR_WORKERS=1
DISTILL_LLM_WORKERS=3
DISTILL_MAX_ACTIVE=3
DISTILL_RETRY_LIMIT=2
# 0=转写完整性通过后清理临时媒体；1=保留媒体
DISTILL_KEEP_MEDIA=0

# ---- 抖音采集来源（auto=优先 sidecar，失败回退浏览器）----
# sidecar 指外部运行的 Evil0ctal / Douyin_TikTok_Download_API 服务
DOUYIN_SOURCE=auto
DOUYIN_SIDECAR_URL=http://127.0.0.1:8000
DOUYIN_SIDECAR_TIMEOUT=30
